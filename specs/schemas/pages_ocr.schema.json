{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "pages_ocr.jsonl (une ligne)",
  "description": "Une page de référence OCR, retapée.",
  "type": "object",
  "properties": {
    "reference_source": {
      "type": "string",
      "minLength": 1
    },
    "page": {
      "type": "string",
      "minLength": 1
    },
    "texte_retape": {
      "type": "string",
      "minLength": 1
    },
    "retape_par": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "relu_par": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "reference_source",
    "page",
    "texte_retape"
  ],
  "additionalProperties": false
}
