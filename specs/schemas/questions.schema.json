{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "questions.jsonl (une ligne)",
  "description": "Une question du corpus.",
  "type": "object",
  "properties": {
    "question_id": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "profil": {
      "type": "string",
      "minLength": 1
    },
    "redigee_par": {
      "type": "string",
      "enum": [
        "metier",
        "ia_relue",
        "production"
      ]
    },
    "type_reponse": {
      "type": "string",
      "enum": [
        "fait",
        "liste",
        "calcul",
        "explication",
        "synthese"
      ]
    },
    "reponse_dans_documents": {
      "type": "string",
      "enum": [
        "oui",
        "non",
        "non_accessible"
      ]
    },
    "reponse_attendue": {
      "type": "string",
      "minLength": 1
    },
    "difficulte": {
      "type": "string",
      "enum": [
        "facile",
        "moyenne",
        "difficile"
      ]
    },
    "frequence": {
      "type": "string",
      "enum": [
        "frequente",
        "occasionnelle",
        "rare"
      ]
    },
    "gravite": {
      "type": "string",
      "enum": [
        "faible",
        "moyenne",
        "forte"
      ]
    },
    "reservee_decision": {
      "type": "boolean"
    },
    "reponse_est_dans": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "un_passage",
            "plusieurs_a_combiner",
            "plusieurs_un_suffit",
            "ensemble_documents"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "points_cles": {
      "anyOf": [
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "texte": {
                "type": "string",
                "minLength": 1
              },
              "valeur": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "unite": {
                "anyOf": [
                  {
                    "type": "string",
                    "minLength": 1
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "tolerance": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "texte"
            ],
            "additionalProperties": false
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "question_precedente": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "variante_de": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "annotateur": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "date": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
        },
        {
          "type": "null"
        }
      ]
    },
    "colonnes_libres": {
      "anyOf": [
        {
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "question_id",
    "question",
    "profil",
    "redigee_par",
    "type_reponse",
    "reponse_dans_documents",
    "reponse_attendue",
    "difficulte",
    "frequence",
    "gravite",
    "reservee_decision"
  ],
  "additionalProperties": false,
  "if": {
    "properties": {
      "reponse_dans_documents": {
        "const": "oui"
      }
    }
  },
  "then": {
    "required": [
      "reponse_est_dans",
      "points_cles"
    ],
    "properties": {
      "reponse_est_dans": {
        "type": "string"
      },
      "points_cles": {
        "type": "array"
      }
    }
  }
}
