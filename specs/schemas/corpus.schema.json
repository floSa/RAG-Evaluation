{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "corpus.json",
  "description": "Une version du corpus, écrite par l'import du kit.",
  "type": "object",
  "properties": {
    "contrat": {
      "type": "string",
      "minLength": 1
    },
    "version_corpus": {
      "type": "string",
      "minLength": 1
    },
    "projet": {
      "type": "string",
      "minLength": 1
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "fichier_source": {
      "type": "string",
      "minLength": 1
    },
    "colonnes_libres": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "contrat",
    "version_corpus",
    "projet",
    "date",
    "fichier_source",
    "colonnes_libres"
  ],
  "additionalProperties": false
}
