{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "rag.json",
  "description": "La version du RAG évaluée.",
  "type": "object",
  "properties": {
    "contrat": {
      "type": "string",
      "minLength": 1
    },
    "nom": {
      "type": "string",
      "minLength": 1
    },
    "version_rag": {
      "type": "string",
      "minLength": 1
    },
    "type_rag": {
      "type": "string",
      "enum": [
        "vectoriel",
        "graphe",
        "hybride",
        "agent"
      ]
    },
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}(T.*)?$"
    },
    "k": {
      "type": "integer",
      "minimum": 1
    },
    "versions": {
      "type": "object",
      "properties": {
        "index": {
          "type": "string",
          "minLength": 1
        },
        "decoupage": {
          "type": "string",
          "minLength": 1
        },
        "embedding": {
          "type": "string",
          "minLength": 1
        },
        "generation": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "reranker": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "index",
        "decoupage",
        "embedding",
        "generation",
        "prompt",
        "reranker"
      ],
      "additionalProperties": false
    },
    "filtre_droits": {
      "type": "boolean"
    },
    "reglages": {
      "type": "object",
      "description": "Les autres réglages du RAG, autant qu'il en a : nom du réglage → sa valeur (texte, nombre, oui/non).",
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    }
  },
  "required": [
    "contrat",
    "nom",
    "version_rag",
    "type_rag",
    "date",
    "k",
    "versions",
    "filtre_droits"
  ],
  "additionalProperties": false
}
