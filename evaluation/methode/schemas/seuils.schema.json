{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "config/seuils.json",
  "description": "Pour chaque identifiant de score : seuil, sens, bloquant.",
  "type": "object",
  "patternProperties": {
    "^n[1-4]_[a-z0-9_]+$": {
      "type": "object",
      "properties": {
        "seuil": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "sens": {
          "type": "string",
          "enum": [
            "min",
            "max"
          ]
        },
        "bloquant": {
          "type": "boolean"
        }
      },
      "required": [
        "seuil",
        "sens",
        "bloquant"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
