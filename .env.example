# Copier ce fichier en .env (jamais versionné) et renseigner les clés.
# Avec LLM-Service, les deux premiers blocs s'écrivent tout seuls :
#   cd ~/mes_projets/Projet-IA/LLM-Service/service
#   ./scripts/cle.sh creer rag-evaluation-kit  --dans <dépôt>/.env --noms KIT_LLM_URL,KIT_LLM_CLE --hote
#   ./scripts/cle.sh creer rag-evaluation-demo --dans <dépôt>/.env --noms RAG_LLM_URL,RAG_LLM_CLE --hote

# Kit d'évaluation : point d'accès compatible OpenAI du juge (adresse aussi dans config/kit.yaml)
KIT_LLM_URL=http://127.0.0.1:8080/v1
KIT_LLM_CLE=sk-a-remplacer

# RAG de démonstration : point d'accès compatible OpenAI (adresse aussi dans rag_demo/config.yaml)
RAG_LLM_URL=http://127.0.0.1:8080/v1
RAG_LLM_CLE=sk-a-remplacer

# Langfuse du bac à sable : écrit par infra/initialiser.sh
LANGFUSE_BASE_URL=http://127.0.0.1:3100
LANGFUSE_PUBLIC_KEY=pk-lf-a-remplacer
LANGFUSE_SECRET_KEY=sk-lf-a-remplacer
